rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'admin@nt-traders.firebaseapp.com',
          'owner@nttraders.local',
          'hp6235@gmail.com'
        ];
    }

    function isStaff() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function sessionPhone() {
      return get(/databases/$(database)/documents/businesses/noor-traders/staffSessions/$(request.auth.uid)).data.phone;
    }

    function enabledStaffAccount(phone) {
      let account = get(/databases/$(database)/documents/businesses/noor-traders/staffAccounts/$(phone)).data;
      return (!('active' in account) || account.active == true)
        && (!('loginEnabled' in account) || account.loginEnabled == true);
    }

    function validStaffSession() {
      return isStaff() && enabledStaffAccount(sessionPhone());
    }

    function isOutManager() {
      return validStaffSession()
        && get(/databases/$(database)/documents/businesses/noor-traders/staffAccounts/$(sessionPhone())).data.get('canApproveOuts', false) == true;
    }

    function isTicketer() {
      return validStaffSession()
        && (get(/databases/$(database)/documents/businesses/noor-traders/staffAccounts/$(sessionPhone())).data.get('canApproveOuts', false) == true
          || get(/databases/$(database)/documents/businesses/noor-traders/staffAccounts/$(sessionPhone())).data.get('canTicket', false) == true);
    }

    function isManagerPhone(phone) {
      return get(/databases/$(database)/documents/businesses/noor-traders/staffAccounts/$(phone)).data.get('canApproveOuts', false) == true;
    }

    match /businesses/noor-traders/{collectionName}/{docId} {
      allow read: if isOwner() || isOutManager();
      allow write: if isOwner()
        || (isOutManager() && !(collectionName in ['staffAttendance', 'staffSelfies']));
    }

    match /businesses/noor-traders/pushTokens/{tokenId} {
      allow read: if isOwner() || isOutManager();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['token', 'role', 'phone', 'name', 'device', 'at', 'testAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 500;
      allow delete: if isOwner() || isOutManager();
    }

    match /businesses/noor-traders/staffMessages/{msgId} {
      allow read: if validStaffSession() && (sessionPhone() in resource.data.toList || 'all' in resource.data.toList);
      allow update: if validStaffSession()
        && (sessionPhone() in resource.data.toList || 'all' in resource.data.toList)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'replies'])
        && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([sessionPhone()])
        && request.resource.data.replies.diff(resource.data.replies).affectedKeys().hasOnly([sessionPhone()]);
    }

    match /businesses/noor-traders/staffAccounts/{phone} {
      allow get: if isOwner()
        || (isStaff() && phone == sessionPhone()
          && (!('active' in resource.data) || resource.data.active == true)
          && (!('loginEnabled' in resource.data) || resource.data.loginEnabled == true));
    }

    match /businesses/noor-traders/staffSessions/{uid} {
      allow create: if isStaff()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^03[0-9]{9}$')
        && enabledStaffAccount(request.resource.data.phone);
      allow get: if isOwner() || (isStaff() && request.auth.uid == uid);
    }

    match /businesses/noor-traders/staffConfig/{configId} {
      allow get: if configId == 'main' && validStaffSession();
    }

    match /businesses/noor-traders/staffAttendance/{attendanceId} {
      allow read: if validStaffSession() && resource.data.phone == sessionPhone();
      allow create: if validStaffSession()
        && request.resource.data.phone == sessionPhone()
        && attendanceId == request.resource.data.date + '_' + sessionPhone()
        && request.resource.data.serverAt == request.time
        && !('selfie' in request.resource.data);
      allow update: if validStaffSession()
        && resource.data.phone == sessionPhone()
        && request.resource.data.phone == sessionPhone()
        && (!('checkOut' in resource.data) || resource.data.checkOut == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'checkOut', 'checkOutTs', 'checkOutLat', 'checkOutLng', 'checkOutAccuracy', 'checkOutDistance', 'outServerAt'
        ])
        && request.resource.data.outServerAt == request.time;
    }

    match /businesses/noor-traders/staffSelfies/{attendanceId} {
      allow read: if validStaffSession() && resource.data.phone == sessionPhone();
      allow create: if validStaffSession()
        && request.resource.data.keys().hasOnly(['phone', 'date', 'selfie', 'at'])
        && request.resource.data.phone == sessionPhone()
        && attendanceId == request.resource.data.date + '_' + sessionPhone()
        && request.resource.data.selfie is string
        && request.resource.data.selfie.size() <= 300000;
    }

    match /businesses/noor-traders/staffRequests/{requestId} {
      allow read: if validStaffSession() && resource.data.phone == sessionPhone();
      allow create: if validStaffSession()
        && request.resource.data.keys().hasOnly(['phone', 'kind', 'date', 'to', 'half', 'checkIn', 'checkOut', 'reason', 'status', 'createdAt', 'by'])
        && (!('half' in request.resource.data) || request.resource.data.half == ''
          || (request.resource.data.half in ['am', 'pm'] && request.resource.data.kind == 'leave' && request.resource.data.to == request.resource.data.date))
        && request.resource.data.phone == sessionPhone()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.kind in ['leave', 'correction', 'suggestion']
        && request.resource.data.status == 'pending'
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.to is string
        && request.resource.data.to >= request.resource.data.date
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt is number;
    }

    match /businesses/noor-traders/staffOuts/{outId} {
      allow read: if isTicketer() || (validStaffSession() && resource.data.phone == sessionPhone());
      allow create: if (validStaffSession()
          && request.resource.data.keys().hasOnly(['phone', 'name', 'date', 'reason', 'note', 'minutes', 'status', 'requestedAt', 'serverAt', 'by'])
          && request.resource.data.phone == sessionPhone()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.serverAt == request.time
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 1
          && request.resource.data.minutes <= 600)
        || (isOutManager()
          && request.resource.data.kind == 'break'
          && request.resource.data.status == 'approved'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.serverAt == request.time
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 1
          && request.resource.data.minutes <= 180);
      allow update: if (validStaffSession()
          && resource.data.phone == sessionPhone()
          && request.resource.data.phone == sessionPhone()
          && ((resource.data.status == 'pending'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status == 'cancelled')
            || (resource.data.status == 'approved'
                && request.resource.data.status == 'returned'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnAt', 'returnLat', 'returnLng', 'returnDistance', 'returnAccuracy', 'returnServerAt'])
                && request.resource.data.returnServerAt == request.time)))
        || (isOutManager()
          && ((resource.data.status == 'pending' && resource.data.phone != sessionPhone())
            || resource.data.status == 'approved'));
    }

    match /businesses/noor-traders/staffTickets/{ticketId} {
      allow read: if isTicketer() || (validStaffSession() && resource.data.phone == sessionPhone());
      allow create: if isTicketer()
        && request.resource.data.keys().hasOnly(['phone', 'name', 'date', 'from', 'returnAt', 'note', 'status', 'by', 'byName', 'createdAt', 'serverAt'])
        && request.resource.data.phone != sessionPhone()
        && (isOutManager() || !isManagerPhone(request.resource.data.phone))
        && request.resource.data.status in ['open', 'returned']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.serverAt == request.time
        && request.resource.data.from is number;
      allow update: if isTicketer()
        && resource.data.phone != sessionPhone()
        && resource.data.status == 'open'
        && request.resource.data.status == 'returned'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnAt', 'returnBy', 'returnServerAt'])
        && request.resource.data.returnServerAt == request.time;
    }

    match /businesses/noor-traders/staffSchedules/{phone} {
      allow read: if validStaffSession() && resource.data.phone == sessionPhone();
    }

    match /businesses/noor-traders/staffPayroll/{payrollId} {
      allow read: if validStaffSession() && resource.data.phone == sessionPhone();
    }
  }
}
